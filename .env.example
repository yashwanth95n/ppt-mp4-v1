# --- Copy this file to ".env" and fill in your own key ---

# The ONLY key this app needs - used for BOTH the narration script (Gemini
# text model) and the voice itself (Gemini's native TTS models).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini TTS model to use for the voice:
#   gemini-2.5-flash-preview-tts  - works on the free tier (default)
#   gemini-2.5-pro-preview-tts    - higher quality, but REQUIRES a paid/
#                                    billing-enabled API project
# Note: a "Gemini Plus"/Google AI Pro *app* subscription is separate from
# API billing - this only unlocks if you've linked a Cloud Billing account
# to your AI Studio API project.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Port the app runs on (matches your requirement of localhost:8086)
PORT=8086
